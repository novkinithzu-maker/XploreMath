{
  "name": "xplore-math",
  "productName": "Xplore Math",
  "version": "1.0.0",
  "description": "Xplore Math - a parallelogram learning game",
  "author": "Xplore Math",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.xploremath.app",
    "productName": "Xplore Math",
    "files": ["electron/**/*", "www/**/*"],
    "directories": { "output": "dist" },
    "win":   { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Game" },
    "mac":   { "target": "dmg", "category": "public.app-category.education" }
  }
}
